    {
      "title": "資治通鑑卷第三",
      "items": [
        { "text": "制國有常，利民爲本；從政有經，令行爲上。" }
      ]
    },
    {
      "title": "資治通鑑卷第十",
      "items": [
        { "text": "權不可豫設，變不可先圖；與時遷移，應物變化，設策之機也。" },
